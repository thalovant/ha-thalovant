{
  "_": "ha-thalovant's own copy of the music action vectors (tests/test_music.py). Shape: `world` and `cases`, each case a whole `action` and the `expect`ed answer; `effects` are abstract operations on the fake world, which the test maps from Home Assistant service calls. It is NOT the connector spec's vector file: that one is organised as `validation` (requests to accept or refuse) and `behavior` (`verb` + `args`), and has since gained behaviours this route does not carry (`targets`). This copy is kept by hand; tests/test_music_contract.py compares its world and cases with the spec's `behavior` when the spec package is installed, and is skipped when it is not.",
  "world": {
    "players": [
      {"name": "Kitchen", "area": "Kitchen", "state": "idle"},
      {"name": "Mark2", "area": null, "state": "playing", "title": "Blue", "artist": "Artist X", "queue_uri": "library://track/9"},
      {"name": "Bedroom", "area": "Bedroom", "state": "idle"}
    ],
    "search": {
      "tracks": [
        {"uri": "library://track/1", "name": "Adam's Song", "artists": [{"name": "blink-182"}]},
        {"uri": "library://track/2", "name": "Adam's Song (Live)", "artists": [{"name": "Other"}]}
      ],
      "artists": [{"uri": "library://artist/1", "name": "Queen"}],
      "albums": [{"uri": "library://album/1", "name": "Enema of the State", "artists": [{"name": "blink-182"}]}],
      "playlists": [{"uri": "library://playlist/1", "name": "Jazz Classics"}],
      "radio": [{"uri": "library://radio/1", "name": "Jazz FM"}]
    },
    "favorites": ["library://track/21", "library://track/22"]
  },
  "cases": [
    {"name": "play a track by an artist",
     "action": {"v": 1, "capability": "play_media", "target": {"name": "kitchen"}, "media": {"query": "adam's song", "type": "track", "artist": "blink-182"}},
     "expect": {"response_type": "action_done", "speech_key": "music_playing_by", "placeholders": {"title": "Adam's Song", "artist": "blink-182", "player": "Kitchen"},
                "effects": [{"op": "play", "player": "Kitchen", "uris": ["library://track/1"], "type": "track", "enqueue": "replace"}]}},
    {"name": "the exact title beats the live version",
     "action": {"v": 1, "capability": "play_media", "target": {"name": "kitchen"}, "media": {"query": "Adams Song"}},
     "expect": {"response_type": "action_done", "speech_key": "music_playing_by", "placeholders": {"title": "Adam's Song", "artist": "blink-182", "player": "Kitchen"},
                "effects": [{"op": "play", "player": "Kitchen", "uris": ["library://track/1"], "type": "track", "enqueue": "replace"}]}},
    {"name": "an artist has no by",
     "action": {"v": 1, "capability": "play_media", "target": {"name": "bedroom"}, "media": {"query": "queen"}},
     "expect": {"response_type": "action_done", "speech_key": "music_playing", "placeholders": {"title": "Queen", "artist": "", "player": "Bedroom"},
                "effects": [{"op": "play", "player": "Bedroom", "uris": ["library://artist/1"], "type": "artist", "enqueue": "replace"}]}},
    {"name": "a word of the name finds the radio station",
     "action": {"v": 1, "capability": "play_media", "target": {"name": "kitchen"}, "media": {"query": "jazz", "type": "radio"}},
     "expect": {"response_type": "action_done", "speech_key": "music_playing", "placeholders": {"title": "Jazz FM", "artist": "", "player": "Kitchen"},
                "effects": [{"op": "play", "player": "Kitchen", "uris": ["library://radio/1"], "type": "radio", "enqueue": "replace"}]}},
    {"name": "play next",
     "action": {"v": 1, "capability": "play_media", "target": {"name": "kitchen"}, "media": {"query": "adam's song", "enqueue": "next"}},
     "expect": {"response_type": "action_done", "speech_key": "music_queued_next", "placeholders": {"title": "Adam's Song", "artist": "blink-182", "player": "Kitchen"},
                "effects": [{"op": "play", "player": "Kitchen", "uris": ["library://track/1"], "type": "track", "enqueue": "next"}]}},
    {"name": "add to the queue",
     "action": {"v": 1, "capability": "play_media", "target": {"name": "kitchen"}, "media": {"query": "adam's song", "enqueue": "add"}},
     "expect": {"response_type": "action_done", "speech_key": "music_queued_add", "placeholders": {"title": "Adam's Song", "artist": "blink-182", "player": "Kitchen"},
                "effects": [{"op": "play", "player": "Kitchen", "uris": ["library://track/1"], "type": "track", "enqueue": "add"}]}},
    {"name": "nothing in the library is an answer, not a guess",
     "action": {"v": 1, "capability": "play_media", "target": {"name": "kitchen"}, "media": {"query": "zzzz qqqq"}},
     "expect": {"response_type": "error", "speech_key": "music_not_found", "placeholders": {"query": "zzzz qqqq", "player": "Kitchen"}, "effects": []}},
    {"name": "favorites shuffle",
     "action": {"v": 1, "capability": "play_media", "target": {"name": "mark2"}, "media": {"favorites": true}},
     "expect": {"response_type": "action_done", "speech_key": "music_favorites", "placeholders": {"player": "Mark2"},
                "effects": [{"op": "play", "player": "Mark2", "uris": ["library://track/21", "library://track/22"], "type": "track", "enqueue": "replace"},
                            {"op": "shuffle", "player": "Mark2", "on": true}]}},
    {"name": "more like this",
     "action": {"v": 1, "capability": "play_media", "target": {"name": "mark2"}, "media": {"similar": true}},
     "expect": {"response_type": "action_done", "speech_key": "music_similar", "placeholders": {"title": "Blue", "player": "Mark2"},
                "effects": [{"op": "play", "player": "Mark2", "uris": ["library://track/9"], "type": null, "enqueue": "replace", "radio": true}]}},
    {"name": "what is playing",
     "action": {"v": 1, "capability": "now_playing", "target": {"name": "mark2"}},
     "expect": {"response_type": "query_answer", "speech_key": "music_now_playing_by", "placeholders": {"title": "Blue", "artist": "Artist X", "player": "Mark2"}, "effects": []}},
    {"name": "nothing playing",
     "action": {"v": 1, "capability": "now_playing", "target": {"name": "kitchen"}},
     "expect": {"response_type": "query_answer", "speech_key": "music_nothing_playing", "placeholders": {"player": "Kitchen"}, "effects": []}},
    {"name": "shuffle on",
     "action": {"v": 1, "capability": "shuffle", "value": "on", "target": {"name": "kitchen"}},
     "expect": {"response_type": "action_done", "speech_key": "music_shuffle_on", "placeholders": {"player": "Kitchen"}, "effects": [{"op": "shuffle", "player": "Kitchen", "on": true}]}},
    {"name": "repeat all",
     "action": {"v": 1, "capability": "repeat", "value": "all", "target": {"name": "kitchen"}},
     "expect": {"response_type": "action_done", "speech_key": "music_repeat_all", "placeholders": {"player": "Kitchen"}, "effects": [{"op": "repeat", "player": "Kitchen", "mode": "all"}]}},
    {"name": "a repeat mode that does not exist is not carried out",
     "action": {"v": 1, "capability": "repeat", "value": "sometimes", "target": {"name": "kitchen"}},
     "expect": null},
    {"name": "move the music here from the other room",
     "action": {"v": 1, "capability": "transfer", "target": {"name": "kitchen"}, "other": {"name": "mark2"}},
     "expect": {"response_type": "action_done", "speech_key": "music_transferred", "placeholders": {"player": "Kitchen"}, "effects": [{"op": "transfer", "player": "Kitchen", "source": "Mark2"}]}},
    {"name": "move the music here from whatever is playing",
     "action": {"v": 1, "capability": "transfer", "target": {"name": "kitchen"}},
     "expect": {"response_type": "action_done", "speech_key": "music_transferred", "placeholders": {"player": "Kitchen"}, "effects": [{"op": "transfer", "player": "Kitchen", "source": null}]}},
    {"name": "group two rooms",
     "action": {"v": 1, "capability": "join", "target": {"name": "kitchen"}, "other": {"name": "bedroom"}},
     "expect": {"response_type": "action_done", "speech_key": "music_joined", "placeholders": {"player": "Kitchen", "other": "Bedroom"}, "effects": [{"op": "join", "player": "Kitchen", "with": ["Bedroom"]}]}},
    {"name": "a player grouped with itself is nothing",
     "action": {"v": 1, "capability": "join", "target": {"name": "kitchen"}, "other": {"name": "kitchen"}},
     "expect": null},
    {"name": "ungroup",
     "action": {"v": 1, "capability": "unjoin", "target": {"name": "bedroom"}},
     "expect": {"response_type": "action_done", "speech_key": "music_unjoined", "placeholders": {"player": "Bedroom"}, "effects": [{"op": "unjoin", "player": "Bedroom"}]}},
    {"name": "an unknown speaker is nobody's",
     "action": {"v": 1, "capability": "now_playing", "target": {"name": "garage"}},
     "expect": null},
    {"name": "the speaker's own player is named like the speaker",
     "device_name": "mark2",
     "action": {"v": 1, "capability": "now_playing", "target": {"here": true}},
     "expect": {"response_type": "query_answer", "speech_key": "music_now_playing_by", "placeholders": {"title": "Blue", "artist": "Artist X", "player": "Mark2"}, "effects": []}},
    {"name": "with no room and no namesake, the one player that is playing",
     "device_name": "somewhere else",
     "action": {"v": 1, "capability": "shuffle", "value": "off", "target": {"here": true}},
     "expect": {"response_type": "action_done", "speech_key": "music_shuffle_off", "placeholders": {"player": "Mark2"}, "effects": [{"op": "shuffle", "player": "Mark2", "on": false}]}},
    {"name": "playing somewhere unknown never guesses the player",
     "device_name": "somewhere else",
     "action": {"v": 1, "capability": "play_media", "target": {"here": true}, "media": {"query": "queen"}},
     "expect": null}
  ]
}
